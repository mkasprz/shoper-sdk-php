{
    "name": "shoper/sdk",
    "type": "library",
    "description": "Official PHP SDK for Shoper REST API",
    "keywords": ["shoper", "sdk", "rest-api", "openapi", "ecommerce"],
    "homepage": "https://github.com/dreamcommerce/shoper-sdk-php",
    "license": "MIT",
    "support": {
        "docs": "https://developers.shoper.pl/",
        "source": "https://github.com/dreamcommerce/shoper-sdk-php"
    },
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.5",
        "php-http/discovery": "^1.16",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10",
        "php-http/mock-client": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Shoper\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shoper\\Sdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
